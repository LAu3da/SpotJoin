<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- タブ1：マップ画面 -->
        <RelativeLayout
            android:id="@+id/layout_map_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <fragment
                android:id="@+id/map"
                android:name="com.google.android.gms.maps.MapFragment"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- デジタル庁デザインシステム準拠：情報バナー -->
            <TextView
                android:id="@+id/text_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="48dp"
                android:background="@drawable/bg_card_digital"
                android:elevation="3dp"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp"
                android:text="タグをタップで詳細へ移動 / 長押しで場所指定"
                android:textColor="#1A1A1C"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- 現在地ジャンプボタン -->
            <Button
                android:id="@+id/button_my_location"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_above="@id/button_post"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="10dp"
                android:backgroundTint="#FFFFFF"
                android:elevation="4dp"
                android:text="現在地へ戻る"
                android:textColor="#0044CC"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- プライマリCTAボタン -->
            <Button
                android:id="@+id/button_post"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:backgroundTint="#0044CC"
                android:elevation="6dp"
                android:text="新規イベントを募集する"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- タブ2：一覧・移動案内画面 -->
        <LinearLayout
            android:id="@+id/layout_list_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#F4F6F9"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="48dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <!-- ヘッダーバー -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="石川のイベント一覧"
                    android:textColor="#1A1A1C"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/button_fetch_web_events"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:backgroundTint="#E8F0FE"
                    android:text="県内イベント更新"
                    android:textColor="#0044CC"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- カテゴリ絞り込みフィルター -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/filter_all"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#0044CC"
                        android:text="すべて"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/filter_joined"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="参加・主催予定"
                        android:textColor="#1A1A1C"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/filter_official"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="地域イベント"
                        android:textColor="#1A1A1C"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/filter_recruit"
                        android:layout_width="wrap_content"
                        android:layout_height="42dp"
                        android:backgroundTint="#FFFFFF"
                        android:text="個人募集"
                        android:textColor="#1A1A1C"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </HorizontalScrollView>

            <!-- 並び替えコントロール -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bg_card_digital"
                android:orientation="horizontal"
                android:padding="4dp">

                <Spinner
                    android:id="@+id/spinner_sort_by"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1" />

                <Spinner
                    android:id="@+id/spinner_order"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <ListView
                android:id="@+id/list_events"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="@android:color/transparent"
                android:dividerHeight="0dp" />
        </LinearLayout>

    </FrameLayout>

    <!-- 下部ナビゲーションバー -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <Button
            android:id="@+id/tab_map"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="#0044CC"
            android:text="マップ検索"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/tab_list"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#E5E7EB"
            android:text="一覧・移動案内"
            android:textColor="#1A1A1C"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>