<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F6F9">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/text_post_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="新規イベント募集"
            android:textColor="#1A1A1C"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- イベントタイトル -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_card_digital"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="イベント名（必須）"
                android:textColor="#1A1A1C"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_title"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="#F9FAFB"
                android:hint="例：野々市中央公園でバスケしませんか"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#1A1A1C"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- TimeTree風 日時設定カード（終日スイッチ ＋ 開始・終了） -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_digital"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 終日スイッチ行 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="終日"
                    android:textColor="#1A1A1C"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <Switch
                    android:id="@+id/switch_all_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"
                android:background="#E5E7EB" />

            <!-- 開始日時行 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="開始"
                android:textColor="#4B5563"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_start_date"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1.3"
                    android:backgroundTint="#F3F4F6"
                    android:text="2026/11/20"
                    android:textColor="#1A1A1C"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_start_time"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:backgroundTint="#E8F0FE"
                    android:text="10:00"
                    android:textColor="#0044CC"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 終了日時行 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="終了"
                android:textColor="#4B5563"
                android:textSize="12sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_end_date"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1.3"
                    android:backgroundTint="#F3F4F6"
                    android:text="2026/11/20"
                    android:textColor="#1A1A1C"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_end_time"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:backgroundTint="#E8F0FE"
                    android:text="12:00"
                    android:textColor="#0044CC"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- 定員・詳細設定カード -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card_digital"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="募集定員（0または空欄で定員なし）"
                android:textColor="#1A1A1C"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_max_participants"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="#F9FAFB"
                android:hint="例：6"
                android:inputType="number"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#1A1A1C"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="詳細・持ち物・集合場所"
                android:textColor="#1A1A1C"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/edit_details"
                android:layout_width="match_parent"
                android:layout_height="96dp"
                android:layout_marginTop="6dp"
                android:background="#F9FAFB"
                android:gravity="top"
                android:hint="初心者歓迎です。動きやすい服装で来てください。"
                android:padding="12dp"
                android:textColor="#1A1A1C"
                android:textSize="14sp" />
        </LinearLayout>

        <Button
            android:id="@+id/button_submit_post"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#0044CC"
            android:text="この内容で募集を公開する"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_cancel_post"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#E5E7EB"
            android:text="キャンセル"
            android:textColor="#1A1A1C"
            android:textSize="14sp"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>